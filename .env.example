# Copy this file to .env and fill in your values. Never share .env.

# --- Your details (used in application forms) ---
FULL_NAME=Your Name
PHONE=+910000000000
RESUME_PATH=C:\Users\HP\Desktop\automation\resume.pdf

# --- Job search ---
JOB_TITLE=Full Stack Developer
LOCATION=Remote
MAX_APPLICATIONS_PER_RUN=20

# --- Gmail (for emailing HR). Use a Gmail App Password, NOT your normal password.
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification on)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SEND_HR_EMAILS=true

# --- Job site logins (leave blank to skip a site that needs login) ---
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
INTERNSHALA_EMAIL=
INTERNSHALA_PASSWORD=
WELLFOUND_EMAIL=
WELLFOUND_PASSWORD=
INDEED_EMAIL=
INDEED_PASSWORD=

# --- Browser ---
# false = you can watch it work (recommended for the first few runs)
HEADLESS=false
